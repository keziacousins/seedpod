# Seedpod v2 configuration — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored and is loaded by start.py (load_dotenv). The console-script
# path (`seedpod`) assumes these are already exported.
#
# This file lists EVERY variable v2 reads. `AppConfig.from_env()`
# (seedpod/app/config.py) is the ONLY place os.environ is read in v2 — if a name
# is not below, nothing reads it.
#
# NOTE the SEEDPOD_ prefix: v2 renamed several of v1's bare names
# (DATABASE_URL -> SEEDPOD_DATABASE_URL, API_HOST -> SEEDPOD_API_HOST,
# LOG_LEVEL -> SEEDPOD_LOG_LEVEL). The four third-party tokens keep v1's
# unprefixed names verbatim, because existing CI/deploy tooling already sets them.

# ---------------------------------------------------------------------------
# REQUIRED — v2 fails loudly at startup if these are unset. There is deliberately
# NO production-DB-style default (v1's silent sqlite:///./db/seedpod.db fallback
# is unrepresentable in v2).
# ---------------------------------------------------------------------------

SEEDPOD_DATABASE_URL=sqlite:///./db/seedpod.db

# Fernet keys for secret encryption. Generate a fresh pair with:
#   seedpod-bootstrap generate-keys
# DEV key covers local/ephemeral/staging; PROD key covers production.
SEEDPOD_SECRET_KEY_DEV=
SEEDPOD_SECRET_KEY_PROD=

# ---------------------------------------------------------------------------
# Third-party credentials (optional — each gates a feature)
# ---------------------------------------------------------------------------

# Required for GHCR image resolution (private packages). Without it the manifest
# resolver degrades gracefully to limited resolution rather than failing.
GITHUB_TOKEN=
# Optional override; otherwise taken from config/org.yml
GITHUB_ORGANIZATION=

# Required only for the digitalocean provider.
DIGITALOCEAN_TOKEN=

# Required only for DNS record management (cloud clusters).
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Runtime (all optional — defaults shown)
# ---------------------------------------------------------------------------

SEEDPOD_ENVIRONMENT=development
SEEDPOD_CONFIG_DIR=config
SEEDPOD_API_HOST=0.0.0.0
SEEDPOD_API_PORT=8000
SEEDPOD_CORS_ORIGINS=*

# Comma-separated. Trim this to just what the host can actually run — e.g. on a
# Mac set up for VM-k3s: SEEDPOD_ENABLED_PROVIDERS=tart
# (Providers are constructed at startup and check_ready() is called on each, so
# an enabled-but-unusable provider fails the boot loudly.)
SEEDPOD_ENABLED_PROVIDERS=digitalocean,kind,tart,orbstack

# false disables the reconciler, health poller and orphan-resume. The outbox
# executor and timer poller ALWAYS run (correctness).
SEEDPOD_BACKGROUND_TASKS=true
SEEDPOD_OUTBOX_POLL_INTERVAL=0.25
SEEDPOD_SNAPSHOT_STORAGE_PATH=data/snapshots

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

SEEDPOD_LOG_LEVEL=INFO
# json | text
SEEDPOD_LOG_FORMAT=json
SEEDPOD_LOG_TO_FILE=true
SEEDPOD_LOG_TO_CONSOLE=false
SEEDPOD_LOG_DIR=logs

# ---------------------------------------------------------------------------
# seedpodctl (the HTTP user CLI) — client-side only, NOT read by the server.
# ---------------------------------------------------------------------------

# SEEDPOD_API_URL=http://localhost:8000
# SEEDPOD_API_KEY=            # from: seedpod-bootstrap create-admin <username>
